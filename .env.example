# Canvas browser mode (recommended when your school blocks personal access tokens)
CANVAS_BASE_URL=https://your-school.instructure.com
CANVAS_BROWSER=chrome
# CANVAS_BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Optional alternatives. Leave CANVAS_ACCESS_TOKEN unset to use the saved browser login.
# CANVAS_ACCESS_TOKEN=
# CANVAS_ICAL_URL=https://your-school.instructure.com/feeds/calendars/private-feed.ics

# Google Calendar desktop OAuth client
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

ORGANIZER_TIMEZONE=America/Chicago
# ORGANIZER_CALENDAR_ID=primary

# Optional read-only Outlook Web integration (recommended when school Graph access is blocked).
OUTLOOK_BROWSER=chrome
# OUTLOOK_BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Optional advanced Microsoft Graph mode. The client ID is a public app ID, not a secret.
# OUTLOOK_MODE=graph
# MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Use common for personal or school accounts, or your school's tenant ID if required.
# MICROSOFT_TENANT_ID=common

# Private remote web interface (optional)
# The standard standalone Pi location is detected automatically. Override only when needed:
# PI_COMMAND=C:\Users\you\AppData\Local\pi-node\current\pi.cmd
# PI_PROVIDER=ollama
# PI_MODEL=qwen3.5:9b
ORGANIZER_REMOTE_PORT=8787
